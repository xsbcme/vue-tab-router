{
  "name": "@xsbcme/vue-router-tab",
  "version": "1.2.0-beta.1",
  "description": "Vue Router first adapter for @xsbcme/vue-tab-router.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://xsbcme.github.io/vue-tab-router/",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xsbcme/vue-tab-router.git",
    "directory": "packages/vue-router-tab"
  },
  "bugs": {
    "url": "https://github.com/xsbcme/vue-tab-router/issues"
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "build:watch": "vite build --watch",
    "dev": "vite build --watch",
    "test": "vitest run --typecheck.enabled --typecheck.tsconfig tsconfig.test.json",
    "type-check": "vue-tsc --noEmit"
  },
  "keywords": [
    "vue",
    "vue3",
    "vue-router",
    "tabs",
    "router",
    "multi-tab",
    "admin"
  ],
  "author": "xsbcme",
  "dependencies": {
    "@xsbcme/vue-tab-router": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vite-plugin-externalize-deps": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "vue": "^3.0.0",
    "vue-router": "^4.0.0"
  }
}
