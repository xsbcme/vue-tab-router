{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": false,
    "noEmit": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": ["esnext", "dom"],
    "types": ["vite/client", "vue-router", "@arco-design/web-vue/es/components"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"]
}
