registry = "https://registry.npmmirror.com/"
# @xsbcme:registry = "http://172.10.10.51/nexus/repository/npm-hosted/"
@xsbcme:registry = "http://10.0.0.7/repository/npm-hosted/"
# 安装时锁定精确版本，不添加 ^ 或 ~
save-exact = true
# 禁止将依赖提升到根 node_modules（避免幽灵依赖）
shamefully-hoist = false
# 允许指定包执行构建脚本（postinstall 等）
approve-builds = true